# Copier ce fichier en .env puis renseigner les valeurs.

# Base PostgreSQL locale :
# DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_usine
#
# Base Supabase (Project Settings > Database > Connection string > Session pooler) :
# DATABASE_URL=postgresql://postgres.VOTRE_PROJET:VOTRE_MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/gestion_usine

# Clé secrète pour signer les jetons JWT (longue chaîne aléatoire).
# Pour en générer une : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRE_MINUTES=480

# Origines autorisées par le CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Une pièce est en stock faible si sa quantité est inférieure ou égale à ce seuil
SEUIL_STOCK_FAIBLE=5
